<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vai.lakehouse</groupId>
    <artifactId>sample-spark-application-privacy-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pseudonymize-table-app</artifactId>
  <name>pseudonymize-table-app</name>
  <description>
    Spark job khử định danh (giả danh hoá) 1 bảng: nhận tên DB, tên bảng, danh sách cột cần khử định danh; ghi ra bảng
    đích đã giả danh bằng lib pseudonym-udf (HASH / ENCRYPT / MAPPING). Xem pseudonymize-table-app/README.md.
  </description>

  <dependencies>
    <!--
      Lib giả danh + hạ tầng lấy khoá: "provided" — KHÔNG shade vào fat jar. Image copy 2 jar này vào /opt/app và
      manifest nạp qua spark.jars (UDF thật nên executor cũng cần), giống pseudonym-verify-app.
    -->
    <dependency>
      <groupId>vai.lakehouse</groupId>
      <artifactId>pseudonym-udf</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>vai.lakehouse</groupId>
      <artifactId>key-prefix-lib</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      Patch lenient block token (đọc/ghi HDFS Isilon có wire encryption): jar classifier "block-token-patch" của
      spark-app, shade vào fat jar; loại mọi dependency bắc cầu của spark-app.
    -->
    <dependency>
      <groupId>vai.lakehouse</groupId>
      <artifactId>sample-spark-application-privacy</artifactId>
      <version>${project.version}</version>
      <classifier>block-token-patch</classifier>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Đọc/ghi bảng Delta và chế độ MAPPING; image apache/spark không có Delta -> đóng gói vào fat jar (giống spark-app). -->
    <dependency>
      <groupId>io.delta</groupId>
      <artifactId>delta-spark_${scala.binary.version}</artifactId>
      <version>${delta.version}</version>
    </dependency>

    <dependency>
      <groupId>org.scala-lang</groupId>
      <artifactId>scala-library</artifactId>
      <version>${scala.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>provided</scope>
    </dependency>
    <!--
      Hive support (ENABLE_HIVE_SUPPORT): `enableHiveSupport()` nằm sẵn trong spark-sql; spark-hive chỉ cần ở runtime và
      có sẵn trong /opt/spark/jars của image Spark — không khai ở đây (giống spark-app).
    -->
    <!-- AES-SIV của lib (Spark ship sẵn tink 1.9.0). -->
    <dependency>
      <groupId>com.google.crypto.tink</groupId>
      <artifactId>tink</artifactId>
      <version>1.9.0</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>${hadoop.version}</version>
      <scope>provided</scope>
      <exclusions>
        <!-- commons-text 1.4 của hadoop-common đè bản 1.10.0 của Spark -> NoSuchMethodError trong test. -->
        <exclusion>
          <groupId>org.apache.commons</groupId>
          <artifactId>commons-text</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <version>${scalatest.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Tên jar cố định: Dockerfile và mainApplicationFile trong k8s/*.yaml trỏ đúng tên này. -->
    <finalName>pseudonymize-table-app</finalName>
    <plugins>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- BẮT BUỘC: giữ META-INF/services của patch block token và DataSourceRegister của Delta. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>vai.lakehouse.pseudonymizetable.app.PseudonymizeTableApp</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <!-- KHÔNG relocate org.apache.hadoop.*: patch phải kế thừa đúng BlockTokenIdentifier của runtime. -->
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
